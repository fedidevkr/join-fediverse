---
const apps = [
  { name: 'Mastodon', logo: '/images/logos/fediverse/mastodon.svg' },
  { name: 'Pixelfed', logo: '/images/logos/fediverse/pixelfed.svg' },
  { name: 'PeerTube', logo: '/images/logos/fediverse/peertube.svg' },
  { name: 'Lemmy', logo: '/images/logos/fediverse/lemmy.svg' },
  { name: 'WriteFreely', logo: '/images/logos/fediverse/writefreely.svg' },
  { name: 'Hackers Pub', logo: '/images/logos/fediverse/hackerspub.svg' },
  { name: 'Misskey', logo: '/images/logos/fediverse/misskey.svg' },
];
---

<header class="hero" id="top">
  <div class="wrap">
    <div class="hero-left">
      <h1>
        작은 동네들이<br />
        모여<br />
        <span class="hl">하나의 인터넷</span>이<br />
        돼요.
      </h1>
      <p class="lead">
        한 동네에 글을 올리면, 다른 동네 사람들도 보고 답장해요. 그림 그리는 동네, 코드 짜는 동네,
        새벽에 글 쓰는 동네 — 마음에 드는 곳 하나 골라서 시작하면 돼요.
      </p>
      <div class="cta-row">
        <a href="#communities" class="btn btn-primary">
          동네 둘러보기 <span class="arr">→</span>
        </a>
      </div>
      <p class="hero-note">
        광고 없이, 글이 올라온 순서대로 흘러요. 무엇을 볼지는 내가 골라요.
      </p>
    </div>

    <div class="hero-vis" aria-hidden="true">
      <article class="card cA">
        <div class="c-head">
          <div class="av">민</div>
          <div class="meta">
            <span class="name">민지</span>
            <span class="hand">@minji@hackers.pub</span>
          </div>
        </div>
        <div class="c-body">
          오늘 리팩터링한 코드, 한 줄로 줄었는데 테스트가 두 배 늘었다. <span class="tag">#devlog</span>
        </div>
        <div class="c-foot"><span>♡ 24</span><span>↻ 7</span><span>💬 5</span></div>
      </article>

      <article class="card cB">
        <div class="c-head">
          <div class="av">준</div>
          <div class="meta">
            <span class="name">준호</span>
            <span class="hand">@jun@oeee.cafe</span>
          </div>
        </div>
        <div class="c-body">
          새벽 낙서. 밝을 때 다시 보면 또 다르겠지. <span class="tag">#일러스트</span>
        </div>
        <div class="c-foot"><span>♡ 48</span><span>↻ 12</span></div>
      </article>

      <article class="card cC">
        <div class="c-head">
          <div class="av">현</div>
          <div class="meta">
            <span class="name">현수</span>
            <span class="hand">@hyun@kurry.social</span>
          </div>
        </div>
        <div class="c-body">
          <span class="at">@minji</span> 같은 동네 아닌데 알림이 딱 와서 신기 😆
        </div>
        <div class="c-foot"><span>♡ 31</span><span>↻ 3</span><span>💬 9</span></div>
      </article>
    </div>
  </div>
</header>

<div class="strip">
  <div class="wrap">
    <span class="label">여기서 돌아가는 앱들</span>
    <div class="apps">
      {
        apps.map((a) => (
          <span class="app" title={a.name}>
            <img src={a.logo} alt={a.name} width="30" height="30" loading="lazy" />
            <span class="app-name">{a.name}</span>
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    padding: 72px 0 72px;
    overflow: hidden;
  }
  .hero .wrap {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(36px, 4.6vw, 62px);
    line-height: 1.3;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0 0 22px;
    color: var(--ink);
  }
  .hero h1 .hl {
    display: inline-block;
    position: relative;
    padding: 0 6px;
    background: var(--mint);
    border-radius: 8px;
    transform: rotate(-1deg);
  }

  .hero .lead {
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 50ch;
    margin: 0 0 28px;
  }

  .hero-note {
    margin: 24px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-3);
  }

  .hero-vis {
    position: relative;
    height: 540px;
    isolation: isolate;
  }

  .card {
    position: absolute;
    background: white;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px;
    box-shadow:
      0 2px 4px rgba(15, 21, 18, 0.03),
      0 20px 40px -20px rgba(15, 21, 18, 0.14);
    transition: transform 0.3s ease;
  }
  .card:hover {
    transform: translateY(-4px) rotate(0) !important;
  }
  .card .c-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .card .av {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
  }
  .card .meta {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }
  .card .meta .name {
    font-weight: 600;
    font-size: 13.5px;
    color: var(--ink);
  }
  .card .meta .hand {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-3);
  }
  .card .c-body {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .card .c-body .tag {
    color: var(--lilac-deep);
    font-weight: 500;
  }
  .card .c-body .at {
    color: var(--mint-deep);
    font-weight: 500;
  }
  .card .c-foot {
    margin-top: 12px;
    display: flex;
    gap: 14px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-3);
  }

  .cA {
    top: 20px;
    left: 30px;
    width: 280px;
    transform: rotate(-3deg);
    z-index: 3;
  }
  .cB {
    top: 90px;
    right: 10px;
    width: 260px;
    transform: rotate(2.5deg);
    z-index: 4;
  }
  .cC {
    bottom: 40px;
    left: 60px;
    width: 300px;
    transform: rotate(1.5deg);
    z-index: 5;
  }
  .cA .av {
    background: var(--mint-soft);
    color: var(--mint-deep);
  }
  .cB .av {
    background: var(--lilac-soft);
    color: var(--lilac-deep);
  }
  .cC .av {
    background: #ffe0d0;
    color: #b54020;
  }

  .strip {
    padding: 24px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .strip .wrap {
    display: flex;
    gap: 40px;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .strip .label {
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 600;
    color: var(--ink-2);
    letter-spacing: -0.005em;
  }
  .strip .apps {
    display: flex;
    gap: 22px 28px;
    flex-wrap: wrap;
    align-items: center;
  }
  .strip .app {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.005em;
    color: var(--ink);
    filter: grayscale(0.2);
    opacity: 0.88;
    transition:
      filter 0.2s,
      opacity 0.2s;
  }
  .strip .app:hover {
    filter: none;
    opacity: 1;
  }
  .strip .app img {
    width: 30px;
    height: 30px;
    object-fit: contain;
    display: block;
  }

  @media (max-width: 1024px) {
    .hero {
      padding: 64px 0 64px;
    }
    .hero .wrap {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero-vis {
      height: 500px;
      max-width: 520px;
      margin: 0 auto;
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding: 48px 0 48px;
    }
    .hero h1 {
      font-size: clamp(32px, 8vw, 46px);
      margin-bottom: 16px;
    }
    .hero .lead {
      font-size: 15.5px;
      margin-bottom: 24px;
    }
    .hero-vis {
      height: 440px;
      margin: 0 -12px;
    }
    .cA {
      width: 230px;
      top: 10px;
      left: 10px;
    }
    .cB {
      width: 220px;
      right: 10px;
      top: 70px;
    }
    .cC {
      width: 250px;
      bottom: 20px;
      left: 30px;
    }
    .strip {
      padding: 20px 0 32px;
    }
    .strip .wrap {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .strip .apps {
      gap: 18px;
    }
  }
</style>
