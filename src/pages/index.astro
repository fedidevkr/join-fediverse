---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Communities from '../components/Communities.astro';
import DevWelcome from '../components/DevWelcome.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Platforms from '../components/Platforms.astro';
import Possibilities from '../components/Possibilities.astro';
import Bridge from '../components/Bridge.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'joinfediverse.kr',
  alternateName: '연합우주 한국어 안내',
  url: 'https://joinfediverse.kr',
  inLanguage: 'ko-KR',
  description:
    '연합우주(페디버스)의 한국어 안내. Mastodon·Misskey·Pixelfed 같은 작은 공동체들이 모여 있어요.',
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'joinfediverse.kr',
  url: 'https://joinfediverse.kr',
  sameAs: ['https://github.com/fedidevkr/join-fediverse'],
};
---

<Layout
  title="연합우주 — 작은 공동체들이 모여 있는 소셜 네트워크"
  description="연합우주(페디버스) 한국어 안내. Mastodon·Misskey·Pixelfed 같은 작은 공동체 중에서, 분위기가 맞는 곳을 골라 시작해보세요."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(websiteSchema)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
  />
  <Nav />
  <Hero />
  <Communities />
  <DevWelcome />
  <Platforms />
  <HowItWorks />
  <Possibilities />
  <Bridge />
  <FinalCTA secondary={{ href: '/faq', label: '궁금한 게 있어요' }} />
  <Footer />
</Layout>
